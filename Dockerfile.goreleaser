FROM alpine:3.23 AS builder

# ca-certificates 20261020-r0 or later distrusts the compromised eMudhra intermediates.
# Do not mask failures here: a build that cannot install the fixed bundle must fail.
RUN apk update \
    && apk upgrade --no-cache \
    && apk add --no-cache "ca-certificates>=20261020" \
    && update-ca-certificates \
    && rm -rf /var/cache/apk/*

COPY nancy /

#--------------------------------
# Deployment Image
#--------------------------------
FROM scratch

#Import from builder image
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /nancy /nancy

ENTRYPOINT [ "/nancy" ]
